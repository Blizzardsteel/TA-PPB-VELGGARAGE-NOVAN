<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <radialGradient id="grad-oz-ultraleggera" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#242424" />
      <stop offset="60%" stop-color="#141414" />
      <stop offset="100%" stop-color="#080808" />
    </radialGradient>
    <linearGradient id="metal-oz-ultraleggera" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#555" />
      <stop offset="50%" stop-color="#222" />
      <stop offset="100%" stop-color="#444" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="500" height="500" fill="url(#grad-oz-ultraleggera)" />
  
  <!-- Outer Wheel Tire Profile -->
  <circle cx="250" cy="250" r="242" fill="#0B0B0B" stroke="#1F1F1F" stroke-width="4"/>
  <circle cx="250" cy="250" r="238" fill="none" stroke="#2C2C2C" stroke-width="1" stroke-dasharray="8 4"/>

  <!-- Wheel Design -->
  
      <circle cx="250" cy="250" r="235" fill="#161616" stroke="#666" stroke-width="5"/>
      <circle cx="250" cy="250" r="220" fill="#1E1E1E" stroke="#333" stroke-width="2"/>
      <!-- Dual 6-Spoke Thin Racing Pattern (12 thin spokes) -->
      <rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(-6 250 250)" />
<rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(54 250 250)" />
<rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(114 250 250)" />
<rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(174 250 250)" />
<rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(234 250 250)" />
<rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(294 250 250)" />

      <rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(6 250 250)" />
<rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(66 250 250)" />
<rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(126 250 250)" />
<rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(186 250 250)" />
<rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(246 250 250)" />
<rect x="245.5" y="90" width="9" height="160" rx="2.25" fill="#C0C0C0" transform="rotate(306 250 250)" />

      <circle cx="250" cy="250" r="50" fill="#121212" stroke="#444" stroke-width="3"/>
      <!-- Carbon style center cap with OZ Racing logo -->
      <circle cx="250" cy="250" r="30" fill="#080808" stroke="#CC0000" stroke-width="2"/>
      <text x="250" y="254" fill="#FFF" font-family="Arial, sans-serif" font-weight="900" font-size="12" text-anchor="middle" letter-spacing="1">OZ</text>
      <circle cx="250" cy="212" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="286.14014761921584" cy="238.257354213752" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="272.335839587114" cy="280.742645786248" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="227.66416041288602" cy="280.742645786248" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="213.85985238078416" cy="238.257354213752" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />

    

  <!-- Brand & Specs Watermark Badge -->
  <rect x="20" y="20" width="180" height="38" fill="#080808" fill-opacity="0.8" rx="4" stroke="#282828" stroke-width="1"/>
  <text x="30" y="36" fill="#FFFFFF" font-family="'Inter', sans-serif" font-weight="900" font-size="11" letter-spacing="1">OZ RACING ITALY</text>
  <text x="30" y="49" fill="#888888" font-family="'Inter', sans-serif" font-size="8" letter-spacing="0.5">FLOW FORMED MONOBLOCK</text>

  <rect x="300" y="445" width="180" height="35" fill="#080808" fill-opacity="0.8" rx="4" stroke="#282828" stroke-width="1"/>
  <text x="390" y="460" fill="#E5E5E5" font-family="'Inter', sans-serif" font-weight="bold" font-size="10" text-anchor="middle" letter-spacing="1">VELGGARAGE</text>
  <text x="390" y="472" fill="#777777" font-family="'Inter', sans-serif" font-size="7.5" text-anchor="middle">AUTHENTIC WHEEL CATALOG</text>
</svg>