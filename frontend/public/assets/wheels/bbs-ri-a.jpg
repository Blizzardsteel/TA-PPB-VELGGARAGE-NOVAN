<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <radialGradient id="grad-bbs-ri-a" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#242424" />
      <stop offset="60%" stop-color="#141414" />
      <stop offset="100%" stop-color="#080808" />
    </radialGradient>
    <linearGradient id="metal-bbs-ri-a" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#555" />
      <stop offset="50%" stop-color="#222" />
      <stop offset="100%" stop-color="#444" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="500" height="500" fill="url(#grad-bbs-ri-a)" />
  
  <!-- Outer Wheel Tire Profile -->
  <circle cx="250" cy="250" r="242" fill="#0B0B0B" stroke="#1F1F1F" stroke-width="4"/>
  <circle cx="250" cy="250" r="238" fill="none" stroke="#2C2C2C" stroke-width="1" stroke-dasharray="8 4"/>

  <!-- Wheel Design -->
  
      <circle cx="250" cy="250" r="235" fill="#161616" stroke="#444" stroke-width="4"/>
      <circle cx="250" cy="250" r="215" fill="#0D0D0D" stroke="#222" stroke-width="2"/>
      <!-- 5 Split Y-Spokes (10 total arms) -->
      <rect x="242" y="90" width="16" height="160" rx="4" fill="#A39162" transform="rotate(-10 250 250)" />
<rect x="242" y="90" width="16" height="160" rx="4" fill="#A39162" transform="rotate(62 250 250)" />
<rect x="242" y="90" width="16" height="160" rx="4" fill="#A39162" transform="rotate(134 250 250)" />
<rect x="242" y="90" width="16" height="160" rx="4" fill="#A39162" transform="rotate(206 250 250)" />
<rect x="242" y="90" width="16" height="160" rx="4" fill="#A39162" transform="rotate(278 250 250)" />

      <rect x="242" y="90" width="16" height="160" rx="4" fill="#A39162" transform="rotate(10 250 250)" />
<rect x="242" y="90" width="16" height="160" rx="4" fill="#A39162" transform="rotate(82 250 250)" />
<rect x="242" y="90" width="16" height="160" rx="4" fill="#A39162" transform="rotate(154 250 250)" />
<rect x="242" y="90" width="16" height="160" rx="4" fill="#A39162" transform="rotate(226 250 250)" />
<rect x="242" y="90" width="16" height="160" rx="4" fill="#A39162" transform="rotate(298 250 250)" />

      <circle cx="250" cy="250" r="55" fill="#1A1A1A" stroke="#333" stroke-width="3"/>
      <circle cx="250" cy="250" r="32" fill="#0A0A0A" stroke="#A39162" stroke-width="2"/>
      <text x="250" y="255" fill="#A39162" font-family="Arial, sans-serif" font-weight="900" font-size="13" text-anchor="middle" letter-spacing="1">BBS</text>
      <circle cx="250" cy="208" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="289.94437368439645" cy="237.0212862362522" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="274.6869805962839" cy="283.9787137637478" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="225.31301940371614" cy="283.9787137637478" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="210.05562631560355" cy="237.0212862362522" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />

    

  <!-- Brand & Specs Watermark Badge -->
  <rect x="20" y="20" width="180" height="38" fill="#080808" fill-opacity="0.8" rx="4" stroke="#282828" stroke-width="1"/>
  <text x="30" y="36" fill="#FFFFFF" font-family="'Inter', sans-serif" font-weight="900" font-size="11" letter-spacing="1">BBS</text>
  <text x="30" y="49" fill="#888888" font-family="'Inter', sans-serif" font-size="8" letter-spacing="0.5">MONOBLOCK FORGED RACING</text>

  <rect x="300" y="445" width="180" height="35" fill="#080808" fill-opacity="0.8" rx="4" stroke="#282828" stroke-width="1"/>
  <text x="390" y="460" fill="#E5E5E5" font-family="'Inter', sans-serif" font-weight="bold" font-size="10" text-anchor="middle" letter-spacing="1">VELGGARAGE</text>
  <text x="390" y="472" fill="#777777" font-family="'Inter', sans-serif" font-size="7.5" text-anchor="middle">AUTHENTIC WHEEL CATALOG</text>
</svg>