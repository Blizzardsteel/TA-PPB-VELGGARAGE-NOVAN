<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <radialGradient id="grad-rays-volk-te37" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#242424" />
      <stop offset="60%" stop-color="#141414" />
      <stop offset="100%" stop-color="#080808" />
    </radialGradient>
    <linearGradient id="metal-rays-volk-te37" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#555" />
      <stop offset="50%" stop-color="#222" />
      <stop offset="100%" stop-color="#444" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="500" height="500" fill="url(#grad-rays-volk-te37)" />
  
  <!-- Outer Wheel Tire Profile -->
  <circle cx="250" cy="250" r="242" fill="#0B0B0B" stroke="#1F1F1F" stroke-width="4"/>
  <circle cx="250" cy="250" r="238" fill="none" stroke="#2C2C2C" stroke-width="1" stroke-dasharray="8 4"/>

  <!-- Wheel Design -->
  
      <circle cx="250" cy="250" r="235" fill="#121212" stroke="#6E5638" stroke-width="6"/>
      <circle cx="250" cy="250" r="215" fill="#1A1612" stroke="#4A3B26" stroke-width="3"/>
      <circle cx="250" cy="250" r="190" fill="#0D0D0D"/>
      <!-- Iconic 6 Broad Spoke Concave -->
      <rect x="236" y="100" width="28" height="150" rx="7" fill="#8C6D45" transform="rotate(0 250 250)" />
<rect x="236" y="100" width="28" height="150" rx="7" fill="#8C6D45" transform="rotate(60 250 250)" />
<rect x="236" y="100" width="28" height="150" rx="7" fill="#8C6D45" transform="rotate(120 250 250)" />
<rect x="236" y="100" width="28" height="150" rx="7" fill="#8C6D45" transform="rotate(180 250 250)" />
<rect x="236" y="100" width="28" height="150" rx="7" fill="#8C6D45" transform="rotate(240 250 250)" />
<rect x="236" y="100" width="28" height="150" rx="7" fill="#8C6D45" transform="rotate(300 250 250)" />

      <!-- Spoke inner bevels -->
      <rect x="243" y="110" width="14" height="140" rx="3.5" fill="#A68252" transform="rotate(0 250 250)" />
<rect x="243" y="110" width="14" height="140" rx="3.5" fill="#A68252" transform="rotate(60 250 250)" />
<rect x="243" y="110" width="14" height="140" rx="3.5" fill="#A68252" transform="rotate(120 250 250)" />
<rect x="243" y="110" width="14" height="140" rx="3.5" fill="#A68252" transform="rotate(180 250 250)" />
<rect x="243" y="110" width="14" height="140" rx="3.5" fill="#A68252" transform="rotate(240 250 250)" />
<rect x="243" y="110" width="14" height="140" rx="3.5" fill="#A68252" transform="rotate(300 250 250)" />

      <circle cx="250" cy="250" r="50" fill="#16120D" stroke="#6E5638" stroke-width="4"/>
      <!-- Volk Racing engraved logo badge -->
      <rect x="230" y="140" width="40" height="8" fill="#1B3F8B" rx="2" transform="rotate(0 250 250)"/>
      <text x="250" y="146" fill="#FFF" font-family="Arial, sans-serif" font-weight="bold" font-size="6" text-anchor="middle">VOLK</text>
      <circle cx="250" cy="212" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="286.14014761921584" cy="238.257354213752" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="272.335839587114" cy="280.742645786248" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="227.66416041288602" cy="280.742645786248" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />
<circle cx="213.85985238078416" cy="238.257354213752" r="6" fill="#1A1A1A" stroke="#444" stroke-width="2" />

      <circle cx="250" cy="250" r="20" fill="#0A0A0A" stroke="#8C6D45" stroke-width="2"/>
      <text x="250" y="254" fill="#DDD" font-family="Arial, sans-serif" font-weight="bold" font-size="9" text-anchor="middle">RAYS</text>
    

  <!-- Brand & Specs Watermark Badge -->
  <rect x="20" y="20" width="180" height="38" fill="#080808" fill-opacity="0.8" rx="4" stroke="#282828" stroke-width="1"/>
  <text x="30" y="36" fill="#FFFFFF" font-family="'Inter', sans-serif" font-weight="900" font-size="11" letter-spacing="1">RAYS VOLK RACING</text>
  <text x="30" y="49" fill="#888888" font-family="'Inter', sans-serif" font-size="8" letter-spacing="0.5">FORGED 1-PIECE MONOBLOCK</text>

  <rect x="300" y="445" width="180" height="35" fill="#080808" fill-opacity="0.8" rx="4" stroke="#282828" stroke-width="1"/>
  <text x="390" y="460" fill="#E5E5E5" font-family="'Inter', sans-serif" font-weight="bold" font-size="10" text-anchor="middle" letter-spacing="1">VELGGARAGE</text>
  <text x="390" y="472" fill="#777777" font-family="'Inter', sans-serif" font-size="7.5" text-anchor="middle">AUTHENTIC WHEEL CATALOG</text>
</svg>